/* CodexBarXInstallerGlassTheme: dark glass installer skin for Qt Installer Framework. */
* {
    color: #EAF4FF;
    font-family: "Segoe UI Variable Text", "Segoe UI", "Microsoft YaHei UI", "Microsoft YaHei", Arial, sans-serif;
    font-size: 10pt;
}

QWizard {
    background-color: #0F1724;
    border: 1px solid #2A3A4D;
    min-height: 540px;
    min-width: 800px;
}

QWizardPage,
QDialog,
QStackedWidget,
QWidget {
    background-color: #111A29;
    color: #EAF4FF;
}

QFrame {
    background-color: transparent;
    border: none;
}

QLabel {
    background-color: transparent;
    color: #B8C7DA;
}

QLabel:disabled {
    color: #5D6B7C;
}

QLabel#TitleLabel,
QLabel[heading="true"] {
    color: #F7FBFF;
    font-size: 20pt;
    font-weight: 700;
}

QLabel#SubTitleLabel {
    color: #9FB2C8;
    font-size: 10pt;
}

QLabel#MessageLabel {
    background-color: #172234;
    border: 1px solid #2A3A4D;
    border-radius: 8px;
    color: #C9D8EA;
    min-height: 142px;
    min-width: 430px;
    padding: 18px 20px;
}

QLabel#InformationLabel,
QLabel#LicenseInfoLabel {
    color: #9FB2C8;
}

QLabel#ErrorLabel {
    color: #FF8F80;
    font-weight: 600;
}

QLabel#WarningLabel {
    color: #F6C96B;
    font-weight: 600;
}

QGroupBox {
    background-color: #172234;
    border: 1px solid #2A3A4D;
    border-radius: 8px;
    color: #EAF4FF;
    font-weight: 600;
    margin-top: 14px;
    padding: 18px 12px 12px 12px;
}

QGroupBox::title {
    background-color: #172234;
    color: #F7FBFF;
    left: 12px;
    padding: 0 6px;
    subcontrol-origin: margin;
}

QAbstractScrollArea,
QTextEdit,
QPlainTextEdit,
QTextBrowser,
QTreeView,
QTableView,
QListView,
QListWidget {
    background-color: #121C2C;
    alternate-background-color: #172234;
    border: 1px solid #2A3A4D;
    border-radius: 8px;
    color: #DDEBFA;
    outline: none;
    selection-background-color: #255C70;
    selection-color: #F7FBFF;
}

QTextBrowser,
QTextEdit,
QPlainTextEdit {
    padding: 10px;
}

QListView,
QListWidget,
QTreeView,
QTableView {
    show-decoration-selected: 1;
}

QListView::item,
QListWidget::item,
QTreeView::item {
    background-color: transparent;
    border-radius: 6px;
    color: #C9D8EA;
    min-height: 28px;
    padding: 6px 10px;
}

QListView::item:selected,
QListWidget::item:selected,
QTreeView::item:selected {
    background-color: #255C70;
    color: #F7FBFF;
}

QListView::item:hover:!selected,
QListWidget::item:hover:!selected,
QTreeView::item:hover:!selected {
    background-color: #1E3145;
    color: #F7FBFF;
}

QLineEdit,
QComboBox,
QSpinBox {
    background-color: #0F1724;
    border: 1px solid #33475C;
    border-radius: 7px;
    color: #EAF4FF;
    min-height: 29px;
    padding: 5px 10px;
    selection-background-color: #255C70;
    selection-color: #F7FBFF;
}

QLineEdit:hover,
QComboBox:hover,
QSpinBox:hover {
    border-color: #49A3B0;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QTextBrowser:focus,
QTreeView:focus,
QTableView:focus,
QListView:focus,
QListWidget:focus {
    border-color: #57C7D4;
}

QLineEdit:disabled,
QComboBox:disabled,
QSpinBox:disabled {
    background-color: #152033;
    border-color: #26364A;
    color: #657489;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox::down-arrow {
    image: none;
}

QComboBox QAbstractItemView {
    background-color: #121C2C;
    border: 1px solid #33475C;
    color: #EAF4FF;
    selection-background-color: #255C70;
}

QCheckBox,
QRadioButton {
    background-color: transparent;
    color: #C9D8EA;
    spacing: 8px;
}

QCheckBox:hover,
QRadioButton:hover {
    color: #F7FBFF;
}

QCheckBox:disabled,
QRadioButton:disabled {
    color: #657489;
}

QCheckBox::indicator,
QRadioButton::indicator {
    background-color: #0F1724;
    border: 1px solid #476177;
    height: 16px;
    width: 16px;
}

QCheckBox::indicator {
    border-radius: 4px;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator:hover,
QRadioButton::indicator:hover {
    border-color: #49A3B0;
}

QCheckBox::indicator:checked {
    background-color: #49A3B0;
    border-color: #57C7D4;
}

QRadioButton::indicator:checked {
    background-color: #49A3B0;
    border: 4px solid #0F1724;
}

QPushButton {
    background-color: #172234;
    border: 1px solid #33475C;
    border-radius: 7px;
    color: #DDEBFA;
    font-weight: 600;
    min-height: 31px;
    min-width: 86px;
    padding: 6px 16px;
}

QPushButton:hover {
    background-color: #1E3145;
    border-color: #49A3B0;
    color: #F7FBFF;
}

QPushButton:focus {
    border-color: #57C7D4;
}

QPushButton:pressed {
    background-color: #255C70;
    border-color: #57C7D4;
}

QPushButton:default {
    background-color: #2F80ED;
    border-color: #65A7FF;
    color: #FFFFFF;
}

QPushButton:default:hover {
    background-color: #3B8FFF;
    border-color: #86BAFF;
}

QPushButton:default:pressed {
    background-color: #2469C8;
    border-color: #49A3B0;
}

QPushButton:disabled {
    background-color: #141E2D;
    border-color: #253347;
    color: #647386;
}

QProgressBar {
    background-color: #0F1724;
    border: 1px solid #33475C;
    border-radius: 7px;
    color: #EAF4FF;
    min-height: 21px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #49A3B0;
    border-radius: 6px;
}

QHeaderView::section {
    background-color: #172234;
    border: 1px solid #2A3A4D;
    color: #EAF4FF;
    font-weight: 600;
    padding: 6px;
}

QScrollBar:vertical {
    background-color: #111A29;
    border: none;
    margin: 0;
    width: 10px;
}

QScrollBar::handle:vertical {
    background-color: #33475C;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: #49A3B0;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: #111A29;
    border: none;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #33475C;
    border-radius: 5px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #49A3B0;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

QToolTip {
    background-color: #172234;
    border: 1px solid #49A3B0;
    color: #F7FBFF;
    padding: 5px;
}
