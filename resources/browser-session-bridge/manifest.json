{
  "manifest_version": 3,
  "name": "CodexBarX Browser Session Bridge",
  "version": "1.0.0",
  "description": "Bridge browser sessions to CodexBarX for secure cookie import.",
  "key": "",
  "permissions": [
    "cookies",
    "storage",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.cursor.com/*",
    "https://cursor.com/*",
    "https://*.chatgpt.com/*",
    "https://chatgpt.com/*",
    "https://*.chat.openai.com/*",
    "https://chat.openai.com/*",
    "https://*.claude.ai/*",
    "https://claude.ai/*",
    "https://*.kimi.com/*",
    "https://kimi.com/*",
    "https://*.opencode.ai/*",
    "https://opencode.ai/*",
    "https://*.ampcode.com/*",
    "https://ampcode.com/*",
    "https://*.abacus.ai/*",
    "https://abacus.ai/*",
    "https://*.augmentcode.com/*",
    "https://augmentcode.com/*",
    "https://*.factory.ai/*",
    "https://factory.ai/*",
    "https://*.app.factory.ai/*",
    "https://app.factory.ai/*",
    "https://*.perplexity.ai/*",
    "https://perplexity.ai/*",
    "https://*.minimax.io/*",
    "https://minimax.io/*",
    "https://*.minimaxi.com/*",
    "https://minimaxi.com/*",
    "https://*.platform.minimax.io/*",
    "https://platform.minimax.io/*",
    "https://*.platform.minimaxi.com/*",
    "https://platform.minimaxi.com/*",
    "https://*.ollama.com/*",
    "https://ollama.com/*",
    "https://*.mistral.ai/*",
    "https://mistral.ai/*",
    "https://*.admin.mistral.ai/*",
    "https://admin.mistral.ai/*",
    "https://*.auth.mistral.ai/*",
    "https://auth.mistral.ai/*",
    "https://*.aliyun.com/*",
    "https://aliyun.com/*",
    "https://*.alibabacloud.com/*",
    "https://alibabacloud.com/*",
    "https://*.xiaomimimo.com/*",
    "https://xiaomimimo.com/*",
    "https://*.platform.xiaomimimo.com/*",
    "https://platform.xiaomimimo.com/*",
    "https://*.manus.im/*",
    "https://manus.im/*",
    "https://*.api.manus.im/*",
    "https://api.manus.im/*",
    "https://*.commandcode.ai/*",
    "https://commandcode.ai/*",
    "https://*.api.commandcode.ai/*",
    "https://api.commandcode.ai/*",
    "https://*.windsurf.com/*",
    "https://windsurf.com/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["runtime.json"],
      "matches": []
    }
  ]
}
